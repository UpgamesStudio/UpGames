{
  "SessionStart": [
    {"matcher": "startup|resume|clear|compact", "hooks": [{"type": "command", "command": "node \"{{DIR}}/hooks/ponytail-activate.js\"", "timeout": 15}]}
  ],
  "SubagentStart": [
    {"hooks": [{"type": "command", "command": "node \"{{DIR}}/hooks/ponytail-subagent.js\"", "timeout": 15}]}
  ],
  "UserPromptSubmit": [
    {"hooks": [{"type": "command", "command": "node \"{{DIR}}/hooks/ponytail-mode-tracker.js\"", "timeout": 15}]}
  ]
}
